# Copie este archivo como .env para cambiar la configuración (todo es opcional).

# Puerto del equipo donde se abre el tablero: http://localhost:8000
PUERTO=8000

# Si se define, subir o eliminar reportes exige este token (recomendado si el
# tablero es accesible por más personas que la Secretaría).
ADMIN_TOKEN=

# Meta institucional de días para atender una gestión (vista "Tiempos de atención").
META_DIAS_ATENCION=6

# Secciones con al menos este número de estudiantes y sin auxiliar quedan "en revisión".
UMBRAL_SECCION_GRANDE=60

# Tamaño máximo por reporte subido, en MB, y de un .zip con varios reportes.
MAX_MB=25
MAX_PAQUETE_MB=200

# Cada cuántos segundos se revisa la carpeta entrada/ (0 = desactivado).
INTERVALO_ENTRADA_SEG=10

# Predicciones: amortiguamiento de la tendencia (0.8 a 0.98) y nivel del intervalo (0.5 a 0.95).
PRED_AMORTIGUAMIENTO=0.9
PRED_NIVEL=0.8
